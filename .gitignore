# ==================== Binaries & Compiled Output ====================
# Build droppings, not sources. One trap worth naming: `go build` with no `-o`
# writes the binary into the package directory, which is how
# .release/tools/relcheck/ came to be holding a 4 MB relcheck.exe — invisible
# to `git status` precisely because the rule below ignores it, and 4 MB of
# nothing in the source tree. Prefer `go run ./tool` (what CI does) or
# `go build -o <path>`.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go build output
/bin/
web/canvas/dist/

# Test & Coverage
coverage
coverage.html
coverage.out
coverage.txt
*.coverprofile

# ==================== Go ====================
# Vendor (use go mod instead)
# /vendor/

# Go workspace
go.work
go.work.sum

# ==================== Rust / WASM ====================
/target/
*.wasm
# ...except the two artifacts that are inputs, not build droppings: the example
# plugin a customer can actually run, and the copy pkg/plugin's tests load.
!examples/hello-plugin/hello.wasm
!pkg/plugin/testdata/hello.wasm

# ==================== Node.js / Web ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# ==================== IDE & Editor ====================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ==================== Tool Directories ====================
.codegraph/
.compose/
.mimocode/

# ==================== Runtime Data ====================
data/events/
data/snapshots/
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# ==================== Logs ====================
*.log
logs/

# ==================== Environment & Secrets ====================
.env
.env.local
.env.*.local
*.pem
*.key

# ==================== Agent Scratch Space ====================
# Agent drafts / audit output. `_` prefix is ignored by the go toolchain.
_scratch/

# Runtime leftovers from earlier verification runs. docs/.d1-scratch held a
# 31 MB binary and a SQLite WAL before this rule existed; catch the pattern, not
# just the one directory.
.d*-scratch/
.d-scratch/

# ==================== Temporary Scripts ====================
fix_encoding.py

# Temporary format/debug files
.*_fmt.txt
.fmt_*.go
*.tmpfmt
