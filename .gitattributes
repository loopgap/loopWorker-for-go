# Line ending normalization
# Go source files must always use LF (gofmt requirement)
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf

# Text files (auto-detect, normalize to LF on commit)
*.md    text
*.json  text
*.js    text
*.jsx   text
*.css   text
*.html  text
*.svg   text
*.yml   text
*.yaml  text
*.toml  text
Makefile        text
*.sh    text
*.bat   text

# Shell scripts
*.rs    text

# Binary files (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.db    binary
*.sqlite binary
*.wasm  binary
